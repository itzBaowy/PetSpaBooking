{
  "name": "PetSpaBooking",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter api db:generate",
    "db:sync": "pnpm --filter api db:sync",
    "db:seed": "pnpm --filter api db:seed",
    "db:clean": "pnpm --filter api db:clean",
    "db:reseed": "pnpm --filter api db:reseed",
    "db:studio": "pnpm --filter api db:studio",
    "docker:dev": "pnpm --filter api docker:dev"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "turbo": "^2.9.15",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": "20.x"
  }
}
