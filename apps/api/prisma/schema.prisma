// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model users {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userName  String     @unique
  password  String
  phone     String     @unique
  email     String     @unique
  fullName       String?
  avatar         String?    @default("public/images/default_avatar")
  avatarPublicId String?
  role           String     @default("CUSTOMER")
  status    String     @default("ACTIVE")
  createAt  DateTime   @default(now())
  updateAt  DateTime   @updatedAt
  customers customers?
}

model customers {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  userId   String    @unique @db.ObjectId
  location String
  pets     pets[]
  reviews  reviews[]

  users users @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model providers {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  userId        String  @unique @db.ObjectId
  businessName  String
  slug          String  @unique
  description   String?
  avatarUrl     String?
  coverImageUrl String?
  phone         String?
  email         String?

  address  String?
  ward     String?
  district String?
  province String?

  taxCode           String?
  identityNumber    String?
  identityFullName  String?
  identityDob       String?
  identityAddress   String?
  bankCode          String?
  bankAccountNumber String?
  bankAccountName   String?
  lat               Float?
  lng               Float?
  providerStatus    String  @default("PENDING_VERIFICATION")
  depositStatus     String  @default("NOT_PAID")
  depositBalance    Float   @default(0)
  walletBalance     Float   @default(0)
  cancellationRate  Float   @default(0)
  adminNote         String?

  payOnline Boolean @default(true)
  payCash   Boolean @default(true)

  createAt DateTime @default(now())
  updateAt DateTime @updatedAt

  services          services[]
  reviews           reviews[]
  workingHours      working_hours[]
  providerDocuments provider_documents[]
}

model provider_documents {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  providerId   String   @db.ObjectId
  documentType       String
  imageUrl           String
  cloudinaryPublicId String?
  status             String   @default("PENDING")
  adminNote          String?
  createAt     DateTime @default(now())
  updateAt     DateTime @updatedAt

  provider providers @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model services {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  providerId      String   @db.ObjectId
  name            String
  description     String?
  longDescription String   @default("")
  price           Float
  duration        Int
  category        String   @default("OTHER")
  imageUrls       String[]

  targetPets String[] @default([])
  benefits   String[] @default([])

  isActive        Boolean  @default(true)
  isHiddenByAdmin Boolean  @default(false)
  createAt        DateTime @default(now())
  updateAt        DateTime @updatedAt

  provider providers @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model reviews {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  providerId String   @db.ObjectId
  customerId String   @db.ObjectId
  rating     Int
  comment    String?
  createAt   DateTime @default(now())

  provider  providers @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customers customers @relation(fields: [customerId], references: [id])
}

model working_hours {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  providerId String  @db.ObjectId
  dayOfWeek  Int
  openTime   String
  closeTime  String
  isClosed   Boolean @default(false)

  provider providers @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model pets {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId      String   @db.ObjectId
  name            String
  breed           String
  gender          String
  ageLabel        String
  imageUrl        String
  status          String
  weight          String
  height          String
  color           String
  criticalNote    String?
  nextVaccineDate String?
  photos          String[] @default([])

  healthReminder HealthReminder?
  medicalRecords MedicalRecord[]

  createAt DateTime @default(now())
  updateAt DateTime @updatedAt

  customers customers @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

type HealthReminder {
  title String
  date  String
}

type MedicalRecord {
  id          String
  title       String
  description String
  date        String
}
