// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model users {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  userName       String             @unique
  password       String
  phone          String             @unique
  email          String             @unique
  fullName       String?
  avatar         String?            @default("public/images/default_avatar")
  role           String             @default("CUSTOMER")
  expoPushToken  String?
  status         String             @default("ACTIVE")
  createAt       DateTime           @default(now())
  updateAt       DateTime           @updatedAt
  customers      customers?
  notifications  notifications[]
  adminAuditLogs admin_audit_logs[]
  chatMessages   chat_messages[]
}

model customers {
  id       String     @id @default(auto()) @map("_id") @db.ObjectId
  userId   String     @unique @db.ObjectId
  location String
  pets     pets[]
  reviews  reviews[]
  bookings bookings[]

  users users @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model providers {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  userId        String  @unique @db.ObjectId
  businessName  String
  slug          String  @unique
  description   String?
  avatarUrl     String? @default("https://images.unsplash.com/photo-1552053831-71594a27632d?auto=format&fit=crop&w=500&q=80")
  coverImageUrl String? @default("https://images.unsplash.com/photo-1583337130417-3346a1be7dee?auto=format&fit=crop&w=1400&q=80")
  phone         String?
  email         String?

  address  String?
  ward     String?
  district String?
  province String?

  taxCode                    String?
  identityNumber             String?
  identityFullName           String?
  identityDob                String?
  identityAddress            String?
  bankCode                   String?
  bankAccountNumber          String?
  bankAccountName            String?
  lat                        Float?
  lng                        Float?
  providerStatus             String  @default("PENDING_VERIFICATION")
  depositStatus              String  @default("NOT_PAID")
  depositBalance             Float   @default(0)
  walletBalance              Float   @default(0)
  cancellationRate           Float   @default(0)
  adminNote                  String?
  statusBeforeUserSuspension String?

  payOnline Boolean @default(true)
  payCash   Boolean @default(true)

  createAt DateTime @default(now())
  updateAt DateTime @updatedAt

  services           services[]
  reviews            reviews[]
  bookings           bookings[]
  commissionRecords  commission_records[]
  walletTransactions wallet_transactions[]
  withdrawalRequests withdrawal_requests[]
  workingHours       working_hours[]
  availabilityBlocks provider_availability_blocks[]
  providerDocuments  provider_documents[]
}

model provider_documents {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  providerId         String   @db.ObjectId
  documentType       String
  imageUrl           String
  cloudinaryPublicId String?
  status             String   @default("PENDING")
  adminNote          String?
  createAt           DateTime @default(now())
  updateAt           DateTime @updatedAt

  provider providers @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model services {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  providerId      String   @db.ObjectId
  name            String
  description     String?
  longDescription String   @default("")
  price           Float
  duration        Int
  category        String   @default("OTHER")
  imageUrls       String[]

  targetPets String[] @default([])
  benefits   String[] @default([])

  isActive        Boolean  @default(true)
  isHiddenByAdmin Boolean  @default(false)
  createAt        DateTime @default(now())
  updateAt        DateTime @updatedAt

  provider providers  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  bookings bookings[]
}

model bookings {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  customerId String  @db.ObjectId
  providerId String  @db.ObjectId
  serviceId  String  @db.ObjectId
  petId      String? @db.ObjectId

  appointmentStart DateTime
  appointmentEnd   DateTime

  status           String    @default("PENDING")
  paymentMethod    String    @default("CASH")
  paymentStatus    String    @default("UNPAID")
  paymentReference String?
  paidAt        DateTime?
  refundReason       String?
  refundRequestedBy  String?
  refundRequestedAt  DateTime?
  refundResolvedAt   DateTime?
  refundMethod       String?
  refundAmount       Float?
  refundReference    String?
  refundEvidenceUrl  String?
  refundAdminNote    String?

  totalAmount Float
  currency    String  @default("VND")
  note        String?

  cancelReason String?
  rejectReason String?

  confirmedAt  DateTime?
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  rejectedAt   DateTime?
  noArrivalAt  DateTime?

  commissionAmount              Float?
  providerEarning               Float?
  walletCommissionAmount        Float?
  depositCommissionAmount       Float?
  commissionProcessingStartedAt DateTime?
  commissionProcessedAt         DateTime?

  createAt DateTime @default(now())
  updateAt DateTime @updatedAt

  customer            customers              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider            providers              @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service             services               @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  qrLogs              booking_qr_logs[]
  dispute             booking_disputes?
  review              reviews?
  walletTransactions  wallet_transactions[]
  paymentTransactions payment_transactions[]
  commissionRecord    commission_records?
  chatThread          chat_threads?
  chatMessages        chat_messages[]

  @@index([customerId])
  @@index([providerId])
  @@index([serviceId])
  @@index([status])
  @@index([appointmentStart])
}

model commission_records {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  bookingId       String @unique @db.ObjectId
  providerId      String @db.ObjectId
  customerId      String @db.ObjectId
  serviceId       String @db.ObjectId

  bookingAmount    Float
  heldAmount       Float  @default(0)
  commissionRate   Float
  commissionAmount Float
  providerEarning  Float
  paymentMethod    String
  fundSource       String @default("NONE")
  fundStatus       String @default("NOT_HELD")
  status           String @default("PENDING")
  collectedFrom    String?
  failureReason    String?
  releaseReason    String?

  reservedAt DateTime @default(now())
  chargedAt  DateTime?
  releasedAt DateTime?
  failedAt   DateTime?
  createAt   DateTime @default(now())
  updateAt   DateTime @updatedAt

  booking  bookings  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider providers @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([customerId])
  @@index([serviceId])
  @@index([status])
  @@index([paymentMethod])
  @@index([fundStatus])
  @@index([reservedAt])
  @@index([chargedAt])
}

model payment_transactions {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  type        String @default("BOOKING")
  bookingId   String? @db.ObjectId
  customerId  String? @db.ObjectId
  providerId  String @db.ObjectId

  provider    String @default("MOMO")
  orderId     String @unique
  requestId   String @unique
  amount      Float
  status      String    @default("PENDING")
  payUrl      String?
  deeplink    String?
  qrCodeUrl   String?
  resultCode  Int?
  message     String?
  transId     String?
  rawResponse String?
  rawIpn      String?
  paidAt      DateTime?

  createAt DateTime @default(now())
  updateAt DateTime @updatedAt

  booking bookings? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([customerId])
  @@index([providerId])
  @@index([type])
  @@index([provider])
  @@index([status])
}

model chat_threads {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  bookingId     String    @unique @db.ObjectId
  customerId    String    @db.ObjectId
  providerId    String    @db.ObjectId
  lastMessage   String?
  lastMessageAt DateTime?
  createAt      DateTime  @default(now())
  updateAt      DateTime  @updatedAt

  booking  bookings        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  messages chat_messages[]

  @@index([customerId])
  @@index([providerId])
  @@index([lastMessageAt])
}

model chat_messages {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  threadId    String    @db.ObjectId
  bookingId   String    @db.ObjectId
  senderId    String    @db.ObjectId
  senderRole  String
  messageType String    @default("TEXT")
  content     String
  readAt      DateTime?
  createAt    DateTime  @default(now())

  thread  chat_threads @relation(fields: [threadId], references: [id], onDelete: Cascade)
  booking bookings     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender  users        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([bookingId])
  @@index([senderId])
  @@index([createAt])
}

model system_settings {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       Float
  description String?
  updatedBy   String?  @db.ObjectId
  createAt    DateTime @default(now())
  updateAt    DateTime @updatedAt
}

model booking_qr_logs {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  bookingId  String @db.ObjectId
  customerId String @db.ObjectId
  providerId String @db.ObjectId

  action    String
  scannedBy String   @db.ObjectId
  scannedAt DateTime @default(now())
  metadata  String?

  booking bookings @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([customerId])
  @@index([providerId])
}

model booking_disputes {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  bookingId   String    @unique @db.ObjectId
  customerId  String    @db.ObjectId
  providerId  String    @db.ObjectId
  reason      String
  description String?
  evidence    String?
  providerResponse String?
  providerEvidence String?
  providerRespondedAt DateTime?
  status      String    @default("PENDING")
  resolvedBy  String?   @db.ObjectId
  resolvedAt  DateTime?
  adminNote   String?
  adminEvidence String?

  createAt DateTime @default(now())
  updateAt DateTime @updatedAt

  booking bookings @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([providerId])
  @@index([status])
}

model reviews {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  bookingId  String   @unique @db.ObjectId
  providerId String   @db.ObjectId
  customerId String   @db.ObjectId
  rating     Int
  comment    String?
  images     String[] @default([])
  isHiddenByAdmin Boolean @default(false)
  adminNote  String?
  createAt   DateTime @default(now())
  updateAt   DateTime @updatedAt

  provider  providers @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customers customers @relation(fields: [customerId], references: [id])
  booking   bookings  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([customerId])
  @@index([isHiddenByAdmin])
}

model wallet_transactions {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  providerId     String   @db.ObjectId
  bookingId      String?  @db.ObjectId
  idempotencyKey String   @unique
  type           String
  balanceType    String
  amount         Float
  balanceAfter   Float
  note           String?
  createAt       DateTime @default(now())

  provider providers @relation(fields: [providerId], references: [id], onDelete: Cascade)
  booking  bookings? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([bookingId])
  @@index([type])
  @@index([createAt])
}

model withdrawal_requests {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  providerId        String    @db.ObjectId
  amount            Float
  bankCode          String?
  bankAccountNumber String?
  bankAccountName   String?
  status            String    @default("PENDING")
  reason            String?
  adminNote         String?
  requestedAt       DateTime  @default(now())
  reviewedBy        String?   @db.ObjectId
  reviewedAt        DateTime?
  paidAt            DateTime?

  provider providers @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([status])
  @@index([requestedAt])
}

model notifications {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  userId   String    @db.ObjectId
  type     String
  title    String
  message  String
  data     String?
  readAt   DateTime?
  createAt DateTime  @default(now())

  user users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([readAt])
  @@index([createAt])
}

model admin_audit_logs {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  adminId    String   @db.ObjectId
  action     String
  targetType String
  targetId   String?
  metadata   String?
  createAt   DateTime @default(now())

  admin users @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([targetType])
  @@index([targetId])
  @@index([createAt])
}

model working_hours {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  providerId String  @db.ObjectId
  dayOfWeek  Int
  openTime   String
  closeTime  String
  isClosed   Boolean @default(false)

  provider providers @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model provider_availability_blocks {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  providerId String   @db.ObjectId
  startAt    DateTime
  endAt      DateTime
  reason     String?
  createAt   DateTime @default(now())
  updateAt   DateTime @updatedAt

  provider providers @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([startAt])
  @@index([endAt])
}

model pets {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId      String   @db.ObjectId
  name            String
  breed           String
  gender          String
  ageLabel        String
  imageUrl        String
  status          String
  weight          String
  height          String
  color           String
  criticalNote    String?
  nextVaccineDate String?
  photos          String[] @default([])

  healthReminder HealthReminder?
  medicalRecords MedicalRecord[]

  createAt DateTime @default(now())
  updateAt DateTime @updatedAt

  customers customers @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

type HealthReminder {
  title String
  date  String
}

type MedicalRecord {
  id          String
  title       String
  description String
  date        String
}
