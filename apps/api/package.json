{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec tsx index.ts",
    "start": "pnpm exec tsx index.ts",
    "build": "tsc",
    "db:generate": "pnpm exec prisma generate --schema=./prisma/schema.prisma",
    "db:sync": "pnpm exec prisma db push --schema=./prisma/schema.prisma && pnpm exec prisma generate --schema=./prisma/schema.prisma",
    "db:studio": "pnpm exec prisma studio --schema=./prisma/schema.prisma",
    "db:seed": "pnpm exec tsx prisma/seed.ts",
    "db:clean": "pnpm exec tsx prisma/clean.ts",
    "db:reseed": "pnpm run db:clean && pnpm run db:seed",
    "docker:dev": "docker compose up -d mongo mongo-init"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.19",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.4.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "vietqr": "^1.1.9"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.14",
    "prisma": "6.19",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  }
}
